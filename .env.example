# Скопируйте в .env и заполните. Файл .env не коммитится.
# Без заполнения `docker compose up --build` запускает локальную версию: бот выключен,
# мини-приложение и API на http://localhost:8080, вход в API — заголовком X-Dev-User.

# --- MAX ---
# Токен бота (выдан организаторами). Нужен для бота и для проверки initData мини-приложения.
MAX_BOT_TOKEN=
# off — бот выключен; polling — long polling (только локальная разработка); webhook — прод.
BOT_MODE=off
BOT_USERNAME=t84_hakaton_max_bot
# Прод: публичный HTTPS-адрес (вебхук = PUBLIC_URL/webhook) и секрет вебхука (16+ символов A-Za-z0-9_-).
PUBLIC_URL=
WEBHOOK_SECRET=

# --- Веб ---
# Прод: домен (Caddy получит сертификат Let's Encrypt), HTTP_PORT=80, HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Данные ---
POSTGRES_PASSWORD=priemka
# Ключ подписи ссылок на файлы (16+ символов). В проде — случайная строка.
FILES_SECRET=local-files-secret-change-me

# --- Режимы ---
# Демо: демо-профиль, демо-акт, перемотка времени демо-актов.
DEMO_MODE=true
# Вход в API заголовком X-Dev-User без MAX. Только локально: при BOT_MODE=webhook сервис не стартует.
DEV_AUTH=true
# Тестовые учётки для проверки API: роль:токен через запятую (токены 16+ символов, значения не коммитить).
# Пример: chairman:<случайная строка>,resident:<случайная строка>
TEST_ACCOUNTS=
INIT_DATA_TTL=24h
LOG_LEVEL=info
# MTU docker-сети. Уменьшите до MTU VPN-интерфейса хоста, если запросы к MAX из контейнера зависают.
DOCKER_MTU=1500
