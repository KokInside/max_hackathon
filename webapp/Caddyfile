# SITE_ADDRESS: «:80» локально (HTTP) или домен в проде — тогда Caddy сам получает сертификат Let's Encrypt.
{$SITE_ADDRESS::80} {
	encode gzip

	# Бэкенд: API мини-приложения, вебхук MAX, проверка здоровья.
	handle /api/* {
		reverse_proxy app:8080
	}
	handle /webhook {
		reverse_proxy app:8080
	}
	handle /healthz {
		reverse_proxy app:8080
	}

	# Статика мини-приложения (SPA).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 25MB
	}
	log {
		output stdout
		format console
	}
}
