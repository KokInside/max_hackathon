# SITE_ADDRESS: «:80» локально (HTTP) или домен в проде — тогда Caddy сам получает сертификат Let's Encrypt.
{$SITE_ADDRESS::80} {
	encode gzip

	# Бэкенд: API мини-приложения, вебхук MAX, проверка здоровья.
	handle /api/* {
		reverse_proxy app:8080
	}
	handle /webhook {
		reverse_proxy app:8080
	}
	handle /healthz {
		reverse_proxy app:8080
	}

	# Статика мини-приложения (SPA).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Ассеты с хэшем в имени кэшируются навсегда; index.html (в т.ч. на «/» и маршрутах SPA) — всегда свежий.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Браузер учитывает HSTS только из ответа по HTTPS, поэтому локально по HTTP заголовок безвреден.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 25MB
	}
	log {
		output stdout
		format console
	}
}
